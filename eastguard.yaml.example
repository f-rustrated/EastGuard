# EastGuard Configuration

# Secure startup is still gated: see docs/security/roadmap.md.
# Use trusted-development only on isolated test networks; omit permissions_path there.
security_mode: "secure"
certificate_chain_path: "./eastguard/config/node-chain.pem"
private_key_path: "./eastguard/config/node-key.pem"
trust_root_path: "./eastguard/config/cluster-ca.pem"
permissions_path: "./eastguard/config/permissions.json" # format: docs/security/deployment.md

# Sockets and networking
client_port: 2921
cluster_port: 2922
data_port: 2923
host: "0.0.0.0"
advertise_host: "127.0.0.1"

# Directories
data_dir: "./eastguard/data"
meta_dir: "./eastguard/meta"

# Cluster topology and bootstrapping
vnodes_per_node: 256
join_seed_nodes:
  - "127.0.0.1:2922"

# Data plane settings
max_segment_age_secs: 3600
segment_size_limit_bytes: 1073741824
